<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================
       종키(Jongky) AMR - 로봇 본체 정의

       [좌표 규약]  +X 전진 / +Y 왼쪽 / +Z 위   (ROS REP-103)
       [단위]       URDF는 미터(m)/라디안(rad).
                    메시 STL은 mm로 만들어져 scale="0.001"로 축소함.
       [원점]       base_link       = 양쪽 구동 바퀴 축의 정중앙
                    base_footprint  = 그 지점을 구동 바퀴 접지면으로 내린 곳

       [검증됨]     메시 두 개 모두 Z-up, 원점 정합 확인 완료
       [TBD]        센서 좌표 / 질량은 아직 추정값
       ================================================================ -->

  <xacro:macro name="insert_robot" params="namespace is_sim:=false use_mock:=false serial_port cam_tilt_deg laser_yaw_deg tof_pitch_deg tof_yaw_deg">

    <xacro:include filename="$(find jongky_description)/urdf/common/insert_inertia.urdf.xacro"/>

    <!-- ============================================================
         치수 상수 — 값을 바꿀 일이 있으면 여기만 고치면 된다
         ============================================================ -->

    <!-- 구동 바퀴 (실측 확정) -->
    <xacro:property name="wheel_radius"  value="0.0335"/>
    <!-- 실측 24~25. wheel.stl은 접지면까지 26.97이라 실물과 다르다.
         비주얼만 2.5mm 두껍게 보이고 물리·좌표에는 영향 없다. -->
    <xacro:property name="wheel_width"   value="0.0245"/>

    <!-- wheel_y = 트레드/2 = 119.09/2

         제자리 5바퀴 회전 3회로 확정했다. 관절 변화량과 눈으로 읽은
         실제 회전각으로 역산한다.
           L = r x (관절_우 - 관절_좌) / 실제회전각
           1차: 113.45 rad / 1845.0도 -> 118.03 mm
           2차: 111.02 rad / 1782.5도 -> 119.55 mm
           3차: 115.69 rad / 1855.0도 -> 119.71 mm
         세 값이 1.4% 안에 모여 평균 119.09 를 쓴다 (표준편차 0.76mm).

         [주의] odom 누적값으로 역산하면 안 된다. spin 도구는 목표에
         닿는 순간 누적을 끊지만 로봇은 감속하며 더 돈다. 눈으로 읽는
         각도는 그 감속분까지 포함하므로 서로 다른 구간을 비교하게 되어
         보정 부호가 뒤집힌다. 실제로 이 실수로 116.25 -> 113.83 으로
         엉뚱하게 줄였다가 되돌렸다. 관절 변화량에는 감속분이 들어 있다.

         줄자로는 116.25 가 나왔지만(바깥면 140 / 안쪽면 92.5 / 폭 24~25)
         타이어가 눌리면서 생기는 실효 트레드는 그보다 크다.
         메시(wheel.stl)의 120.32 와도 가깝다.

         jongky_control 의 wheel_separation 과 반드시 일치시킬 것. -->
    <xacro:property name="wheel_y"       value="0.059545"/>
    <!-- 메시 두께 중심이 0.6mm 치우쳐 있어 보정 -->
    <xacro:property name="wheel_mesh_dy" value="0.0006"/>

    <!-- 캐스터 (실측 확정, 뒤쪽 2개) -->
    <xacro:property name="caster_radius" value="0.0125"/>
    <xacro:property name="caster_x"      value="-0.12523"/>
    <xacro:property name="caster_y"      value="0.028"/>
    <xacro:property name="caster_z"      value="${caster_radius - wheel_radius}"/>

    <!-- [시뮬 전용] 구르는 캐스터 (is_sim:=true 일 때만 펼쳐진다)

         왜 필요한가 — 고정 구슬은 구르지 못하고 끌린다. 제자리 회전에서
         구동륜과 캐스터가 같은 마찰계수를 쓰므로 비에서 mu 가 상쇄된다.
         즉 지면 마찰을 아무리 바꿔도 이 비는 안 변한다.

           캐스터 하중 분담 = |COM_x| / |caster_x| = 0.04942 / 0.12523 = 39.5%
             -> N_c = 25.535 N x 0.395 = 10.08 N,  N_w = 15.46 N
           캐스터 미끄럼 반경 r_c = sqrt(0.12523^2 + 0.028^2) = 0.12832 m
           저항 토크 = mu x 10.08 x 0.12832 = mu x 1.2931 N.m
           구동 토크 = mu x 15.46 x 0.059545 = mu x 0.9205 N.m
           비 = 0.712 < 1  ->  쿨롱 기준 제자리 회전 자체가 불가능

         실제로 Isaac 에서 최대 각속도 20초에 3.1 rad 밖에 안 돈다
         (이론값의 1/7.4). 복도 폭을 바꿔도 같은 값이 나온다 —
         로봇 동역학 문제이지 환경 문제가 아니다.

         고치면 저항이 미끄럼 마찰(mu~1)에서 구름 저항(c_rr 0.01~0.05)으로
         바뀌므로 비가 14 이상으로 올라간다.
         (캐스터를 별도 링크로 떼면 COM 이 2.2% 뒤로 가서 미끄럼 기준 비는
          0.712 -> 0.687 로 오히려 조금 나빠진다. 구름으로 바꾸는 것이
          바로 그래서 유일한 답이다 — 하중 배치로는 못 뒤집는다.)

         [이게 모델 문제라는 근거] 실물은 제자리 회전을 잘 한다. 위 wheel_y
         를 확정한 실험 자체가 "제자리 5바퀴 회전 3회" 다. 비 0.69 가 실물의
         물리라면 그 실험은 애초에 성립하지 않는다. 즉 0.69 는 끌리는 고정
         구슬로 모델링한 탓이지 실물의 값이 아니다.
         (teleop_key.py · jongky_controllers.yaml 이 말하는 "구르지 못하고
          끌리는 고정 구슬" 은 직진 헤딩이 매번 다르게 밀린다는 관찰이다.
          회전을 막을 정도의 저항이라는 뜻이 아니다.)

         [안 넣은 것] 볼이 소켓 안에서 미끄러지며 생기는 저항은 모델에
         없다. 실물 볼 캐스터면 실효 c_eff 0.1~0.2 쯤이고, 그 값이라도
         비는 4.6~9.1 이라 회전은 문제없다. 넣고 싶으면 아래 두 관절의
         dynamics friction 을 올리면 되는데, Isaac URDF 임포터가 그 값을
         읽는지 확인이 안 됐고 과하게 잡으면 회전이 다시 죽는다
         (관절당 0.05 N.m 이면 비가 0.89 로 되돌아간다). 지금은 0 으로
         두고 tools/check_rotation.py 로 실측부터 하는 순서다.

         [트레일] 스위블 축이 접지점보다 앞에 있어야 캐스터가 진행 방향으로
         스스로 정렬한다. 트레일 0 이면 정렬 복원 모멘트가 없어 옆으로 그냥
         끌리고, 고정 구슬과 다를 게 없어진다. 볼 반지름과 같은 12.5mm 를 준다.
         스위블 각 0(직진 정렬)에서 볼 중심이 실측 캐스터 위치와 정확히
         겹치도록 스위블 축을 caster_x + trail 에 놓는다. -->
    <xacro:property name="caster_trail"     value="${caster_radius}"/>

    <!-- 볼 캐스터 실물 무게. 지름 25mm 플라스틱 볼 + 요크 = 개당 20g 쯤.
         아래에서 body_mass 에 상쇄분을 빼므로 전체 합은 2.603 kg 그대로다.

         [주의] 0 에 가깝게 주면 안 된다. 차체와의 질량비가 커질수록 PhysX
         관절 솔버가 흔들린다 — 바퀴(0.05kg, 50:1)가 armature 를 필요로 했던
         것과 같은 이유다. 여기 20g 은 실물 근사이면서 비를 246:1 로 묶는다.
         볼 관성은 2/5 m r^2 = 6.3e-7 kg.m^2 로 바퀴(2.2e-5)의 1/35 다.
         check_rotation.py 에서 캐스터 롤 속도가 튀면 여기부터 올릴 것
         (강철 볼이면 64g 이 실물값이고 관성도 6배가 된다). -->
    <xacro:property name="caster_ball_mass" value="0.010"/>
    <xacro:property name="caster_yoke_mass" value="0.010"/>

    <!-- 메시 실측 bbox (base_link.stl, mm→m 환산)
         관성 계산은 이 실제 치수로 한다. -->
    <xacro:property name="body_len"      value="0.24952"/>
    <!-- 판 폭 148 = 공식 도면값. 메시도 148.0~148.3으로 일치한다.
         판은 네 모서리가 모따기되어 앞뒤 끝에서 139.7까지 좁아지므로,
         모서리 근처에서 재면 135쯤 나온다. 가운데를 재야 한다. -->
    <xacro:property name="body_wid_real" value="0.148"/>
    <xacro:property name="body_hgt_real" value="0.27180"/>
    <xacro:property name="body_cx"       value="-0.05139"/>
    <xacro:property name="body_com_z"    value="0.10155"/>
    <xacro:property name="body_top_z"    value="0.23745"/>

    <!-- base_link 콜리전 박스
         폭 280은 판 사이 배선 마진을 포함한 의도된 값(실제 차체 폭은 165).
         좁은 통로를 못 지나가면 body_wid만 줄이면 된다.

         [중요] 박스 하단은 메시 bbox 하단(-34.35mm)이 아니라 캐스터 구
         상단에 맞춘다. 메시 bbox를 그대로 쓰면 박스 바닥이 접지면
         (-33.5mm)보다 0.85mm 아래로 내려가고, 그러면 바퀴 구슬과 캐스터
         구슬이 모두 박스 안에 파묻혀 지면에 닿지 않는다. 로봇이 바퀴가
         아니라 차체 박스로 바닥에 얹혀 미끄러지게 된다. -->
    <xacro:property name="body_wid"      value="0.28011"/>
    <xacro:property name="body_bot_z"    value="${caster_z + caster_radius}"/>
    <xacro:property name="body_hgt"      value="${body_top_z - body_bot_z}"/>
    <xacro:property name="body_cz"       value="${(body_top_z + body_bot_z)/2}"/>

    <!-- 센서 위치 (TBD — 전부 추정값, 실측 후 교체할 것) -->
    <xacro:property name="laser_x"       value="0.01174"/>
    <xacro:property name="laser_z"       value="0.21925"/>
    <!-- 카메라 — 앞뒤(x)는 메시에서 부품을 직접 찾아 잡았다.
         메시 길이 249.5는 실측 245~250과 일치하고, 판 229.1은 공식
         브래킷 228과 일치하므로 x 방향은 메시를 신뢰한다.
         (줄자로 잰 x는 바퀴축 위치를 눈으로 잡느라 10~15mm 밀렸다)

         아스트라   : 메시상 x 33.2~73.4, 바닥 188.0~210.3
                      렌즈는 앞면(73.4) 바로 뒤 → x 0.070
         후방 IMX   : 메시상 x −176.1~−154.8, 바닥 131.6~146.2
                      렌즈는 뒷면(−176.1) 바로 앞 → x −0.174
                      높이 138.9는 실측 130~150과 일치 ✓ -->
    <xacro:property name="cam_x"         value="0.070"/>
    <xacro:property name="cam_z"         value="0.1656"/>
    <xacro:property name="rear_cam_x"    value="-0.174"/>
    <xacro:property name="rear_cam_z"    value="0.1054"/>
    <!-- TOF (실측 반영 — 줄자 눈대중이라 ±5mm.
         TOF는 단일점 거리센서라 빔 원뿔에 비하면 이 정도 오차는 무시된다.
         바닥에서 115 → base_link 기준 115 − 33.5 = 81.5 -->
    <xacro:property name="tof_x"         value="0.050"/>
    <xacro:property name="tof_y"         value="0.075"/>
    <xacro:property name="tof_z"         value="0.0815"/>
    <xacro:property name="imu_x"         value="-0.050"/>
    <xacro:property name="imu_z"         value="0.080"/>

    <!-- 질량 — 로봇 전체 실측 2.603 kg (저울)
         바퀴는 따로 안 쟀다. 지름 67 × 폭 24.5 고무/플라스틱 바퀴로
         50g 추정하고, 나머지를 몸통에 몰아준다.
            2.603 − 0.05×2 = 2.503
         바퀴 질량은 몸통의 2%라 추정 오차가 결과에 거의 영향 없다. -->
    <!-- is_sim 이면 캐스터를 별도 링크로 떼어내므로 그만큼 몸통에서 뺀다.
         두 경우 모두 합계는 실측 2.603 kg 으로 같다
         (tools/check_merged.py 가 이 합을 본다). -->
    <xacro:property name="caster_split_mass" value="0.0"/>
    <xacro:if value="${is_sim}">
      <xacro:property name="caster_split_mass" value="${2*(caster_ball_mass + caster_yoke_mass)}"/>
    </xacro:if>
    <xacro:property name="body_mass"     value="${2.503 - caster_split_mass}"/>
    <xacro:property name="wheel_mass"    value="0.05"/>

    <xacro:property name="mesh_scale"    value="0.001 0.001 0.001"/>


    <!-- ============================================================
         base_footprint : 바닥 기준 프레임
         메시도 질량도 없는 순수 좌표. 내비게이션이 기준으로 쓴다.
         ============================================================ -->
    <link name="base_footprint"/>

    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child  link="base_link"/>
      <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>


    <!-- ============================================================
         base_link : 로봇 몸통 전체
         판 4장, 젯슨, 야붐 보드, 배터리, 디스플레이, 스탠드오프,
         모터, 캐스터, 센서 껍데기까지 전부 이 링크 하나.

         콜리전은 메시가 아니라 박스 1개 + 캐스터 구슬 2개.
         물리 엔진은 primitive를 해석적으로 계산해서 메시보다 빠르고
         안정적이다.
         ============================================================ -->
    <link name="base_link">

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://jongky_description/meshes/visual/base_link.stl"
                scale="${mesh_scale}"/>
        </geometry>
        <material name="body_gray">
          <color rgba="0.42 0.44 0.47 1.0"/>
        </material>
      </visual>

      <!-- 차체 충돌 박스 -->
      <collision>
        <origin xyz="${body_cx} 0 ${body_cz}" rpy="0 0 0"/>
        <geometry>
          <box size="${body_len} ${body_wid} ${body_hgt}"/>
        </geometry>
      </collision>

      <!-- 캐스터 2개 : 별도 링크 없이 base_link 의 충돌 구슬로 처리한다.
           실물 스택은 물리를 안 돌리므로 이걸로 충분하고, 이렇게 두면
           /joint_states 에 없는 관절이 안 생겨 robot_state_publisher 와
           TF 가 깨끗하다.

           시뮬(is_sim:=true)에서는 이 구슬을 빼고 아래 insert_caster 가
           구르는 링크로 다시 세운다. 끌리는 구슬이 제자리 회전을 죽인다. -->
      <xacro:unless value="${is_sim}">
        <!-- 왼쪽 캐스터 -->
        <collision>
          <origin xyz="${caster_x} ${caster_y} ${caster_z}" rpy="0 0 0"/>
          <geometry>
            <sphere radius="${caster_radius}"/>
          </geometry>
        </collision>

        <!-- 오른쪽 캐스터 -->
        <collision>
          <origin xyz="${caster_x} ${-caster_y} ${caster_z}" rpy="0 0 0"/>
          <geometry>
            <sphere radius="${caster_radius}"/>
          </geometry>
        </collision>
      </xacro:unless>

      <!-- 관성은 콜리전 박스가 아니라 실제 차체 치수로 계산한다.
           마진 포함된 body_wid(280)를 넣으면 izz가 1.6배로 부풀어
           제자리 회전이 실제보다 둔해진다. -->
      <inertial>
        <origin xyz="${body_cx} 0 ${body_com_z}" rpy="0 0 0"/>
        <mass value="${body_mass}"/>
        <xacro:box_inertia m="${body_mass}" x="${body_len}" y="${body_wid_real}" z="${body_hgt_real}"/>
      </inertial>
    </link>


    <!-- ============================================================
         구동 바퀴 : 좌우 대칭이므로 매크로로 한 번만 작성
         side = 이름에 붙는 글자, dir = +1(왼쪽) / -1(오른쪽)

         [중요] joint의 rpy는 좌우 모두 "0 0 0"이다.
         여기에 180도를 주면 axis까지 뒤집혀 오른쪽 바퀴가 거꾸로 돈다.
         메시 좌우 반전은 <visual><origin>에서만 처리한다.

         [중요] 콜리전이 원통이 아니라 구슬이다.
         원통은 바닥과 선으로 닿아 접촉점이 흔들리지만,
         구슬은 항상 한 점으로 닿아 안정적이고 지름이 같아
         굴러간 거리도 동일하다.

         메시는 이미 회전축이 Y라서 rpy 보정이 필요 없다.
         ============================================================ -->
    <xacro:macro name="insert_wheel" params="side dir">

      <link name="${side}_wheel">
        <visual>
          <origin xyz="0 ${dir*wheel_mesh_dy} 0" rpy="0 0 ${(1-dir)*pi/2}"/>
          <geometry>
            <mesh filename="package://jongky_description/meshes/visual/wheel.stl"
                  scale="${mesh_scale}"/>
          </geometry>
          <material name="wheel_black">
            <color rgba="0.11 0.11 0.12 1.0"/>
          </material>
        </visual>

        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <sphere radius="${wheel_radius}"/>
          </geometry>
        </collision>

        <!-- cylinder_inertia는 회전축이 z인 공식이다. 이 바퀴의 joint
             axis는 y이므로 origin에서 x축으로 90도 돌려 실린더 z축을
             y축에 맞춘다. 안 돌리면 스핀축 관성이 1.64배 어긋난다. -->
        <inertial>
          <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
          <mass value="${wheel_mass}"/>
          <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
        </inertial>
      </link>

      <joint name="${side}_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child  link="${side}_wheel"/>
        <axis   xyz="0 1 0"/>
        <origin xyz="0 ${dir*wheel_y} 0" rpy="0 0 0"/>
      </joint>

    </xacro:macro>

    <xacro:insert_wheel side="l" dir="1"/>
    <xacro:insert_wheel side="r" dir="-1"/>


    <!-- ============================================================
         [시뮬 전용] 구르는 캐스터 — is_sim:=true 에서만 나온다

         구조는 실물 볼 캐스터 그대로다. 관절 2개를 직렬로 건다.

           base_link
             └ ${side}_caster_swivel_joint  (continuous, axis Z)   요크가 방향을 튼다
                 └ ${side}_caster_yoke
                     └ ${side}_caster_roll_joint (continuous, axis Y)  볼이 구른다
                         └ ${side}_caster_ball   (충돌 구슬)

         이 두 자유도면 어느 방향으로 가도 미끄러지지 않고 구를 수 있다.
         제자리 회전에서 캐스터가 지나가는 궤적은 반지름 0.128 m 원의
         접선 방향(거의 ±Y)인데, 요크가 그쪽으로 돌아서면 볼은 순수 구름이
         된다. 직진에서는 요크가 뒤로 정렬해 평범한 캐스터가 된다.

         [왜 X·Y 두 롤 축이 아닌가] 볼 캐스터를 X롤+Y롤 짐벌로 근사하면
         부모 X 관절이 90도 근처로 누적됐을 때 자식 Y 축이 수직이 되어
         전진 방향 구름이 막힌다(짐벌락). 제자리 회전이 X 롤을 무한정
         누적시키므로 반드시 그 상태를 지난다. 스위블 방식엔 그 특이점이 없다.

         [왜 저마찰 재질(mu_caster)이 아닌가] 비가 1을 넘으려면
         mu_c/mu_w < 0.712 이어야 한다. 그런데 PhysX 는 두 재질의 마찰을
         기본적으로 평균으로 합치므로 캐스터 shape 을 mu=0 으로 둬도 지면
         재질(1.0)과 평균되어 실효 0.5 밖에 안 내려간다 -> 비 1.42, 여유
         1.4배뿐이다. 게다가 URDF 에는 접촉면별 마찰을 적을 자리가 없고
         Isaac URDF 임포터도 로봇 전체에 재질 하나만 물린다. 즉 이 방법은
         env 나 USD 후처리를 고쳐야 하고, 그러고도 옆으로 미는 힘 응답이
         실물과 달라진다. 구름으로 가면 저항이 c_rr 0.01~0.05 로 떨어져
         비가 14쯤 되고, 이건 실물 볼 캐스터의 실제 물리 그대로다.

         [USD 변환 주의] 이 관절들은 구동하지 않는 수동 관절이다.
         convert_urdf.py 의 joint-damping 인자는 모든 관절에 일괄로 들어간다.
         100 으로 변환하면 캐스터가 감쇠 100 에 묶여 못 구른다 — 구동륜은
         env 의 ImplicitActuatorCfg 가 덮어쓰지만 캐스터는 덮어쓸 주인이 없다.
         joint-damping 을 0.0 으로 두고 변환할 것. 구동륜 게인은 어차피 env 가
         다시 쓴다. 확인은 sim/jongky_rl/tools/check_rotation.py 가 해준다.
         ============================================================ -->
    <xacro:macro name="insert_caster" params="side dir">

      <!-- 요크 : 수직축으로 도는 부분. 비주얼은 base_link.stl 이 이미
           그리고 있으므로 넣지 않는다 (겹쳐 그리면 z-fighting 만 난다). -->
      <link name="${side}_caster_yoke">
        <inertial>
          <origin xyz="${-caster_trail/2} 0 0" rpy="0 0 0"/>
          <mass value="${caster_yoke_mass}"/>
          <xacro:sphere_inertia m="${caster_yoke_mass}" r="${caster_radius}"/>
        </inertial>
      </link>

      <!-- damping·friction 0 : 수동 관절이라 저항이 있으면 안 된다.
           Isaac 변환기가 URDF 값을 읽는 경로로 들어올 때를 위한 명시이고,
           CLI 인자가 이기는 경로에서는 위 [USD 변환 주의] 를 따라야 한다. -->
      <joint name="${side}_caster_swivel_joint" type="continuous">
        <parent link="base_link"/>
        <child  link="${side}_caster_yoke"/>
        <axis   xyz="0 0 1"/>
        <origin xyz="${caster_x + caster_trail} ${dir*caster_y} ${caster_z}" rpy="0 0 0"/>
        <dynamics damping="0.0" friction="0.0"/>
      </joint>

      <!-- 볼 : 접지하는 유일한 부분. 반지름은 실측 그대로 12.5mm.
           스위블 각 0 에서 중심이 (caster_x, ±caster_y, caster_z) 에 온다 —
           고정 구슬 시절 위치와 정확히 같다. -->
      <link name="${side}_caster_ball">
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <sphere radius="${caster_radius}"/>
          </geometry>
        </collision>

        <inertial>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <mass value="${caster_ball_mass}"/>
          <xacro:sphere_inertia m="${caster_ball_mass}" r="${caster_radius}"/>
        </inertial>
      </link>

      <joint name="${side}_caster_roll_joint" type="continuous">
        <parent link="${side}_caster_yoke"/>
        <child  link="${side}_caster_ball"/>
        <axis   xyz="0 1 0"/>
        <origin xyz="${-caster_trail} 0 0" rpy="0 0 0"/>
        <dynamics damping="0.0" friction="0.0"/>
      </joint>

    </xacro:macro>

    <xacro:if value="${is_sim}">
      <xacro:insert_caster side="l" dir="1"/>
      <xacro:insert_caster side="r" dir="-1"/>
    </xacro:if>


    <!-- ============================================================
         센서 프레임 : 메시도 질량도 없는 빈 링크.
         "이 센서가 로봇 어디에 붙어 있는가"만 알려주는 좌표점이다.
         아래 좌표는 전부 추정값이므로 실측 후 위 property를 고칠 것.
         ============================================================ -->

    <!-- RPLIDAR 스캔 평면. 회전량은 robot.urdf.xacro 의 laser_yaw_deg 로 온다.

         [실측 확정] 0 이다. 라이다 0도가 이미 로봇 정면을 향한다.
         차분 스캔으로 검증했다 — 기준 스캔을 뜬 뒤 정면 20~30cm 에 물체를
         놓고 다시 떠서 거리가 줄어든 각도를 봤다. 350~20도가 일제히 30cm
         대로 떨어졌다 (350도에서 3598 -> 310mm).

         이 주석은 원래 "커넥터가 뒤를 향하니 180도(${pi}) 돌려야 한다" 고
         적혀 있었는데, 그 전제가 이 로봇에는 맞지 않았다. 라이다 베이스의
         ▼ 마커가 로봇 앞을 가리키는 것과도 0 이 일치한다.

         재검증: tools/lidar_yaw.py (ROS 드라이버 없이 시리얼로 직접 잰다) -->
    <link name="laser"/>
    <joint name="laser_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="laser"/>
      <origin xyz="${laser_x} 0 ${laser_z}" rpy="0 0 ${laser_yaw_deg*pi/180}"/>
    </joint>

    <!-- 아스트라 뎁스 카메라. 광학 프레임은 드라이버가 붙인다. -->
    <link name="camera_link"/>
    <joint name="camera_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="camera_link"/>
      <origin xyz="${cam_x} 0 ${cam_z}" rpy="0 ${cam_tilt_deg*pi/180} 0"/>
    </joint>

    <!-- 후방 카메라 (IMX219) -->
    <link name="rear_camera_link"/>
    <joint name="rear_camera_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="rear_camera_link"/>
      <origin xyz="${rear_cam_x} 0 ${rear_cam_z}" rpy="0 0 ${pi}"/>
    </joint>

    <!-- TOF400F 2개. pitch로 숙이고 yaw로 좌우로 벌린다.
         실행 인자로 각도를 바꿀 수 있어 브래킷을 바꿔도 파일 수정 불필요. -->
    <link name="tof_l_link"/>
    <joint name="tof_l_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="tof_l_link"/>
      <origin xyz="${tof_x} ${tof_y} ${tof_z}"
              rpy="0 ${tof_pitch_deg*pi/180} ${tof_yaw_deg*pi/180}"/>
    </joint>

    <link name="tof_r_link"/>
    <joint name="tof_r_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="tof_r_link"/>
      <origin xyz="${tof_x} ${-tof_y} ${tof_z}"
              rpy="0 ${tof_pitch_deg*pi/180} ${-tof_yaw_deg*pi/180}"/>
    </joint>

    <!-- 야붐 제어보드 내장 IMU -->
    <link name="imu_link"/>
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="imu_link"/>
      <origin xyz="${imu_x} 0 ${imu_z}" rpy="0 0 0"/>
    </joint>


    <!-- ============================================================
         ros2_control : diff_drive_controller 가 붙는 지점

         하드웨어는 세 갈래다.
           use_mock:=true   목업. 명령을 그대로 상태로 되돌린다.
                            하드웨어 없이 /cmd_vel -> /odom -> TF 전 경로 검증용
           is_sim:=true     시뮬레이터 (gz_ros2_control). 아직 미배선
           둘 다 false      실물. jongky_hardware 플러그인

         [부호 주의] 이 인터페이스의 관절 속도는 ROS 규약이다 —
         양수 = 전진. 야붐 보드는 반대이므로 부호 반전은 전부
         jongky_hardware 안에서 처리한다. 여기서는 신경 쓰지 않는다.
         근거는 야붐보드-레퍼런스.md "부호 규약" 절.
         ============================================================ -->
    <ros2_control name="jongky" type="system">
      <hardware>
        <xacro:if value="${use_mock}">
          <plugin>mock_components/GenericSystem</plugin>
          <!-- 속도 명령을 적분해 위치 상태를 만들어 준다.
               diff_drive_controller 가 position_feedback:=true 라 필요하다 -->
          <param name="calculate_dynamics">true</param>
        </xacro:if>
        <xacro:unless value="${use_mock}">
          <plugin>jongky_hardware/JongkySystemHardware</plugin>
          <param name="serial_port">${serial_port}</param>
          <param name="baud_rate">115200</param>
          <param name="car_type">1</param>
          <!-- 실측 3회 중 기준점이 명확한 것을 채택.
                 76cm 주행(odom 826.7mm, cpr 1788 설정) -> 1788 x 826.7/760 = 1945
               14cm 주행에서 역산한 1973 과 1.4% 안에서 일치한다.
               예전 3182 는 보드가 자기 내부 상수로 계산한 거리를 역산한
               값이라 순환 논리였다. 보드는 X3 메카넘 차종용이라 바퀴 크기
               가정이 우리와 다르다. -->
          <param name="counts_per_rev">1960</param>
          <!-- 위 치수 상수를 그대로 넘긴다. 하드웨어 인터페이스가
               바퀴속도 -> 차체속도 역산에 쓰므로 URDF 와 어긋나면 안 된다 -->
          <!-- 보드가 vx·vz 를 각속도로 바꿀 때 쓰는 바퀴 크기가 우리와
               다르다. 실측 cmd 0.2 m/s -> 실제 0.144 m/s (0.719배) 이므로
               그 역수를 곱해 보낸다. 보드 가정 반지름 약 46.6mm. -->
          <!-- 보드 속도 PID. 공장 기본은 kp 0.8 / ki 0.06 / kd 0.5 다.
               ki 만 0.1 로 올린다 — 기본값 0.06 은 약한 쪽 모터가 저속에서
               데드밴드를 못 넘겨 좌우가 5.7% 어긋난다. 0.1 로 올리면 1.6%.
               더 올리면(0.2) 저속은 더 좋아지지만 운용속도에서 진동이
               15% -> 18% 로 는다. 두 속도의 절충점이 0.1 이다.
               측정: jongky_calib.py pidsweep, sweep 대상 ki -->
          <param name="motor_pid_kp">0.8</param>
          <param name="motor_pid_ki">0.1</param>
          <param name="motor_pid_kd">0.5</param>
          <param name="board_vel_scale">1.391</param>
          <param name="wheel_radius">${wheel_radius}</param>
          <param name="wheel_separation">${wheel_y*2}</param>
        </xacro:unless>
      </hardware>

      <joint name="l_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-20.0</param>
          <param name="max">20.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="r_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-20.0</param>
          <param name="max">20.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- 야붐 보드 내장 IMU (ICM20948).
           imu_sensor_broadcaster 가 이 인터페이스들을 읽어
           sensor_msgs/Imu 로 발행한다. 이름은 규약 고정이라 바꾸면 안 된다.

           [부호] 보드의 자이로 z 는 시계가 양수다. REP-103 은 반시계가
           양수이므로 jongky_hardware 가 반전해서 채운다. -->
      <sensor name="imu_sensor">
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
      </sensor>
    </ros2_control>

  </xacro:macro>
</robot>
