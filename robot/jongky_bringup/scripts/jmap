#!/usr/bin/env bash
# SLAM + 카메라 + rosbag 기동. 맵핑의 시작이자 끝.
#
#   jmap 10f                 시작
#   [Ctrl+C]                 지도 저장 + 정리까지 자동
#   jmap 10f --no-camera     영상 없이 (bag 이 1/30 로 줄어든다)
#   jmap 10f --no-rviz       화면 없이 (기본은 켜짐)
#
# **RViz 를 켜고 몬다.** 1차 촬영이 실패한 이유의 절반은 아무것도 안 보이는
# 상태로 찍었기 때문이다. 복도가 두 겹으로 그려지는 순간이 화면에 바로
# 나타나는데, 그때 되돌아가 다시 지나가면 루프가 닫혀 보정된다.
# 몇 시간 뒤 재처리해서 알면 이미 늦는다.
#
# 한 번 주행에 지도·waypoint·bag·Cosmos 씨앗 영상이 다 나온다.
# 현장은 다시 가기 비싸므로 받을 수 있는 건 한 번에 받는다.
set -uo pipefail
source "$(dirname "$(readlink -f "$0")")/_common.sh"

FLOOR="${1:-}"
if [ -z "$FLOOR" ]; then
  echo "층 이름을 줄 것:  jmap 10f" >&2
  exit 1
fi
shift || true

WANT_CAM=1
WANT_RVIZ=1          # 지도가 쌓이는 걸 보면서 몰아야 한다. --no-rviz 로 끈다
for a in "$@"; do
  [ "$a" = "--no-camera" ] && WANT_CAM=0
  [ "$a" = "--no-rviz" ]   && WANT_RVIZ=0
done
RVIZ_ARG=false; [ "$WANT_RVIZ" = "1" ] && RVIZ_ARG=true

STAMP="${FLOOR}_$(date +%m%d_%H%M)"
TOPICS="/scan /odom /tf /tf_static /imu/data /joint_states /cmd_vel"

if [ "$WANT_CAM" = "1" ]; then
  TOPICS="$TOPICS /camera/rgb/image_raw"
  CAM_CMD="nohup ros2 launch openni2_camera camera_only.launch.py > /tmp/cam.log 2>&1 < /dev/null & sleep 12;"
  echo "SLAM + 카메라 · bag → ~/bags/$STAMP   (영상 때문에 분당 약 1.9GB)"
  df -h / | awk 'NR==2 {print "  디스크 여유: " $4}'
else
  CAM_CMD=""
  echo "SLAM (영상 없음) · bag → ~/bags/$STAMP"
fi
echo "  주행:  다른 터미널에서  jdrive $FLOOR"
echo "  종료:  여기서 Ctrl+C    (지도 저장·정리까지 자동)"
echo

# Ctrl+C 한 번으로 끝나게 한다. 예전에는 jsave·jstop 을 따로 쳐야 했는데,
# 엘리베이터 타기 전에 빼먹으면 bag 이 계속 돌고 다음 층 맵핑과 충돌한다.
FINISHED=0
finish() {
  [ "$FINISHED" = "1" ] && return
  FINISHED=1
  echo
  echo "── 종료 중 (건드리지 말 것) ──"
  "$(dirname "$(readlink -f "$0")")/jsave" "$FLOOR" 2>&1 | tail -3
  "$(dirname "$(readlink -f "$0")")/jstop" 2>&1 | tail -3
  echo "── 완료 ──"
  exit 0
}
trap finish INT TERM

# 구분자에 주의. `A && B &` 는 체인 전체를 백그라운드로 보내므로 source 가
# 그 서브셸에만 적용되고, 뒤따르는 ros2 launch 가 ROS 없이 돌아 죽는다.
#
# 카메라를 bag 보다 먼저 띄우는 이유: openni2 는 lazy 발행이라 구독자가
# 붙어야 스트림이 돈다. 순서가 반대면 bag 이 빈 토픽을 잡는다.
# 소스가 바뀌었으면 반영한다. colcon 은 변경 없으면 몇 초 만에 끝난다 —
# 스크립트를 고쳐 놓고 빌드를 잊어 옛 코드가 도는 일이 없게 한다.
jongky_exec "$ROS_SETUP; \
  cd /ws && colcon build --packages-select jongky_control jongky_bringup jongky_navigation --symlink-install > /tmp/build.log 2>&1; \
  source /ws/install/setup.bash; \
  mkdir -p /host/bags; \
  $CAM_CMD \
  nohup ros2 bag record -o '/host/bags/$STAMP' $TOPICS > /tmp/bag.log 2>&1 < /dev/null & \
  sleep 3; \
  ros2 launch jongky_navigation bringup_navigation.launch.py mode:=slam use_rviz:=$RVIZ_ARG" &

wait $!
finish
