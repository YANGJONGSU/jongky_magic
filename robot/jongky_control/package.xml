<?xml version="1.0"?>
<package format="3">
  <name>jongky_control</name>
  <version>0.0.1</version>
  <description>종키 AMR 컨트롤러 설정 (ros2_control / diff_drive_controller)</description>
  <maintainer email="you@example.com">jongky</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>jongky_description</exec_depend>

  <!-- use_mock:=true 로 하드웨어 없이 전 경로를 돌릴 때 필요 -->
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
